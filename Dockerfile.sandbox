FROM ubuntu:22.04

LABEL maintainer="AIOps Team"
LABEL description="Sandboxed execution environment for AIOps fix scripts"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    procps \
    net-tools \
    iproute2 \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    jq \
    grep \
    sed \
    gawk \
    findutils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -m -s /bin/bash sandbox

RUN mkdir -p /workspace && chown sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace
