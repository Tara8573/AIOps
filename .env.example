# ============================================================
# AIOps 环境配置
#
# 所有配置项定义在 config/default.yaml（结构化默认值）。
# 本文件仅用于运行时覆盖（敏感信息、环境差异）。
#
# 覆盖约定：AIOPS__<SECTION>__<KEY>=value（双下划线分隔层级）
# 例：AIOPS__LLM__API_KEY=sk-xxx
#     AIOPS__ROUTING__LLM_JUDGE_ENABLED=1
#     AIOPS__KAFKA__TOPIC=prod-alerts
#
# 详见 config/default.yaml 获取完整配置项列表。
# ============================================================

# ---- 核心覆盖（最常修改）----
AIOPS__LLM__API_KEY=
AIOPS__LLM__BASE_URL=https://api.openai.com/v1
AIOPS__LLM__MODEL=

# ---- PG 连接（审计/审批/checkpoint/run registry/认证共用）----
# 优先级：AIOPS__PG__DSN > AIOPS_PG_DSN（旧名，兼容）> kb.pg.dsn
AIOPS__PG__DSN=postgresql://postgres:postgres@127.0.0.1:5432/aiops

# ---- 独立 Agent LLM（可选，默认继承上方 LLM 配置）----
AIOPS__AGENTS__DIAGNOSIS__LLM__PROVIDER=default
AIOPS__AGENTS__EVALUATION__LLM__PROVIDER=default

# ---- LLM 调用事件日志（LLMO-2，调试回放/成本计量）----
AIOPS_LLM_CALL_LOG_ENABLED=1
AIOPS_LLM_CALL_LOG_PATH=logs/llm_calls.jsonl
AIOPS_LLM_CALL_LOG_CAPTURE_CONTENT=1
AIOPS_LLM_CALL_LOG_HASH_CHAIN=0
AIOPS_LLM_CALL_LOG_MAX_MEMORY=100
AIOPS_LLM_CALL_LOG_ROTATE_BYTES=52428800

# ---- 敏感信息（不要写入 YAML）----
AIOPS__KB__PG__DSN=postgresql://postgres:postgres@127.0.0.1:5432/aiops
AIOPS__JIRA__API_TOKEN=
AIOPS__LANGSMITH__API_KEY=

# ---- 代码直读 env（尚未收口 Settings，直接 os.getenv）----
# 修复：补文档 —— 以下开关只认旧式平名 env，写 AIOPS__* 形式不生效
AIOPS_EXECUTOR_MODE=docker            # docker | remote（FR-5 执行器装配）
AIOPS_EXEC_TIMEOUT=300                # 远程执行超时（秒）
AIOPS_SANDBOX_ENABLED=0               # 1 = 沙箱执行面（FR-8 启动自检前提）
AIOPS_SANDBOX_STRICT=1                # STRICT=1 + Docker 不可用 → 拒绝启动
AIOPS_BATCH_SIZE=1                    # 消费分批大小
AIOPS_MAX_WORKERS=4                   # 告警 worker 并发数（0 = 串行）
AIOPS_LLM_JUDGE_ENABLED=0             # 1 = LLM Judge 二次评审
AIOPS_CONSISTENCY_CHECK_ENABLED=1     # 1 = 根因-步骤一致性检查
AIOPS_MIN_CONFIDENCE=0.7              # 方案置信度门槛
AIOPS_ITERATIVE_MAX_RETRIES=1         # 评估迭代修正轮数
AIOPS_DEGRADE_ENABLED=1               # 降级控制器开关（FR-1.3）
AIOPS_DEGRADE_LAG_THRESHOLD=500       # Kafka lag 触发 L1
AIOPS_INGEST_BACKPRESSURE_ENABLED=1   # 入口背压开关（FR-1.1）
AIOPS_AGG_ENABLED=1                   # 风暴聚合开关（FR-1.2）
AIOPS_CANARY_ENABLED=0                # 金丝雀执行开关
AIOPS_APPROVAL_MODE=sync              # sync | async（FR-3）
AIOPS_APPROVAL_TIMEOUT=3600           # 审批超时（秒）
AIOPS_PIPELINE_TIMEOUT_SECONDS=0      # pipeline 总超时（0 = 不限）
AIOPS_PIPELINE_MAX_RETRIES=2          # 可重试异常重试次数
AIOPS_RBAC_ENABLED=0                  # 1 = RBAC 权限点强制（web/approval API）
AIOPS_WEB_API_ENABLED=0               # 1 = 进程内启动 Web API（端口 9093）
AIOPS_WEB_API_AUTH=1                  # Web API 鉴权开关
AIOPS_APPROVAL_API_ENABLED=0          # 1 = 进程内启动审批回调 API（端口 9092）
AIOPS_APPROVAL_API_AUTH=1             # 审批回调 API 鉴权开关
AIOPS_DB_ROLE=service                 # KB 连接会话角色（RLS aiops.role；空 = 不设置）

# ---- LangChain / LangSmith（第三方库直接读取）----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aiops-pipeline
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
