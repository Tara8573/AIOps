# ============================================================
# Runtime
# ============================================================
AIOPS_MODE=demo
AIOPS_LOG_LEVEL=INFO
AIOPS_LOG_JSON=0
AIOPS_LOG_DIR=./logs

# ============================================================
# LLM
# Shared Remote API Gateway
# Used by LLM / embedding / rerank when their dedicated URL/key is empty.
# ============================================================
AIOPS_LLM_PROVIDER=openai
AIOPS_LLM_API_KEY=
AIOPS_LLM_BASE_URL=https://api.openai.com/v1
AIOPS_LLM_MODEL=
AIOPS_LLM_TEMPERATURE=0.2
AIOPS_LLM_TIMEOUT=180
AIOPS_LLM_CACHE_TTL_SECONDS=300
AIOPS_LLM_CACHE_MAX_SIZE=256


# ============================================================
# Knowledge Base - PostgreSQL / pgvector
# ============================================================
AIOPS_USE_PG_KB=0
AIOPS_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/aiops
AIOPS_PG_VECTOR_DIM=1024
AIOPS_PG_TOP_K=3
AIOPS_KB_SEARCH_CACHE_TTL_SECONDS=300
AIOPS_KB_SEARCH_CACHE_MAX_SIZE=256


# ============================================================
# Embedding
# Set AIOPS_EMBEDDING_ENABLED=0 to avoid configuring an external embedding model.
# In that mode, pgvector still works with built-in deterministic local vectors.
# ============================================================
AIOPS_EMBEDDING_ENABLED=0
AIOPS_EMBEDDING_PROVIDER=local
AIOPS_EMBEDDING_API_URL=
AIOPS_EMBEDDING_API_KEY=
AIOPS_EMBEDDING_API_KEY_HEADER=Authorization
AIOPS_EMBEDDING_API_KEY_PREFIX=Bearer
AIOPS_EMBEDDING_MODEL=
AIOPS_EMBEDDING_INPUT_FIELD=input
AIOPS_EMBEDDING_MODEL_FIELD=model
AIOPS_EMBEDDING_VECTOR_PATH=data.0.embedding
AIOPS_EMBEDDING_TIMEOUT_SECONDS=20
AIOPS_EMBEDDING_FALLBACK_LOCAL=1


# ============================================================
# Rerank
# Set AIOPS_RERANK_ENABLED=0 to avoid configuring a rerank model.
# ============================================================
AIOPS_RERANK_ENABLED=0
AIOPS_RERANK_API_URL=
AIOPS_RERANK_API_KEY=
AIOPS_RERANK_API_KEY_HEADER=Authorization
AIOPS_RERANK_API_KEY_PREFIX=Bearer
AIOPS_RERANK_MODEL=
AIOPS_RERANK_QUERY_FIELD=query
AIOPS_RERANK_DOCS_FIELD=documents
AIOPS_RERANK_MODEL_FIELD=model
AIOPS_RERANK_SCORES_PATH=results
AIOPS_RERANK_SCORE_FIELD=relevance_score
AIOPS_RERANK_INDEX_FIELD=index
AIOPS_RERANK_TIMEOUT_SECONDS=20
AIOPS_RERANK_CANDIDATE_K=10
AIOPS_RERANK_FALLBACK_VECTOR=1


# ============================================================
# Knowledge Deduplication
# ============================================================
AIOPS_KB_APPROX_DEDUPE_ENABLED=1
AIOPS_KB_APPROX_DEDUPE_CANDIDATE_K=5
AIOPS_KB_APPROX_DEDUPE_DISTANCE_THRESHOLD=0.08
AIOPS_KB_APPROX_DEDUPE_OVERLAP_THRESHOLD=0.65
AIOPS_KB_APPROX_DEDUPE_TEXT_SIMILARITY_THRESHOLD=0.72


# ============================================================
# Jira Knowledge MVP
# ============================================================
AIOPS_USE_JIRA_KNOWLEDGE=0
JIRA_KNOWLEDGE_DB=data/jira_knowledge.db
JIRA_KNOWLEDGE_TOP_K=5
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=OPS,SRE
JIRA_JQL=
JIRA_SYNC_DAYS=365
JIRA_MAX_RESULTS=100
JIRA_TIMEOUT_SECONDS=20


# ============================================================
# Kafka Alert Source
# ============================================================
AIOPS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AIOPS_KAFKA_TOPIC=aiops-alerts
AIOPS_KAFKA_GROUP_ID=aiops-consumer
AIOPS_KAFKA_AUTO_OFFSET_RESET=latest
AIOPS_KAFKA_POLL_TIMEOUT_MS=1000
AIOPS_KAFKA_MAX_POLL_RECORDS=100
AIOPS_KAFKA_FIELD_MAP=
AIOPS_KAFKA_DEDUP_WINDOW=300
AIOPS_KAFKA_MIN_LEVEL=Info
AIOPS_KAFKA_INCLUDE_PATTERNS=
AIOPS_KAFKA_EXCLUDE_PATTERNS=
AIOPS_KAFKA_EXCLUDE_SOURCES=
AIOPS_KAFKA_TITLE_EXCLUDE_PATTERNS=


# ============================================================
# Routing / Evaluation
# ============================================================
AIOPS_MIN_CONFIDENCE=0.7
AIOPS_DANGEROUS_SCRIPT_PATTERNS=
AIOPS_BATCH_SIZE=1
AIOPS_ROUTER_MANUAL_PATTERNS=
AIOPS_ROUTER_FAST_TRACK_PATTERNS=
